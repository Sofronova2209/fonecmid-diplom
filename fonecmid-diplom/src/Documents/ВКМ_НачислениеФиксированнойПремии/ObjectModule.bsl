Процедура ОбработкаПроведения(Отказ, РежимПроведения)

    СформироватьДвиженияДополнительныеНачисления();

    Движения.ВКМ_ДополнительныеНачисления.Записать();
	Движения.ВКМ_Удержания.Записать();

КонецПроцедуры

Процедура СформироватьДвиженияДополнительныеНачисления()

НДФЛ = 0.13;

    Для Каждого СтрокаТЧ Из СписокСотрудников Цикл

        Движение = Движения.ВКМ_ДополнительныеНачисления.Добавить();
        Движение.ПериодРегистрации = Дата; // Используем дату документа
        Движение.ВидРасчета = ПланыВидовРасчета.ВКМ_ДополнительныеНачисления.Премия; // Получаем ссылку на предопределенный вид расчета
        Движение.Сотрудник = СтрокаТЧ.Сотрудник;
        Движение.Сумма= СтрокаТЧ.СуммаПремии; // Сумма из табличной части
                
        НовоеДвижениеУдержания  = Движения.ВКМ_Удержания.Добавить();
        НовоеДвижениеУдержания.ПериодРегистрации  = Движение.ПериодРегистрации;
        НовоеДвижениеУдержания.Сотрудник  = Движение.Сотрудник;
        НовоеДвижениеУдержания.ВидРасчета  = ПланыВидовРасчета.ВКМ_Удержания.НДФЛ;
        НовоеДвижениеУдержания.Сумма        =  Движение.Сумма*НДФЛ;
       
	КонецЦикла;  
	
	Движения.ВКМ_ДополнительныеНачисления.Записать();
	Движения.ВКМ_Удержания.Записать();
	
	СформироватьДвиженияПоРегиструВзаиморасчетыССотрудниками();
	
КонецПроцедуры

   Процедура СформироватьДвиженияПоРегиструВзаиморасчетыССотрудниками()
	
       // 1. Собираем уникальный список сотрудников из табличной части
    ТЧНачисления = СписокСотрудников.Выгрузить();  

    Сотрудники = Новый Массив;

    Для Каждого СтрокаТЧ Из ТЧНачисления Цикл
        Сотрудники.Добавить(СтрокаТЧ.Сотрудник );
    КонецЦикла;


    // 2. Единый запрос для получения сумм начислений и удержаний по сотрудникам
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ
    |	СУММА(ВКМ_ДополнительныеНачисления.Сумма) КАК СуммаНачисления,
    |	ВКМ_ДополнительныеНачисления.Сотрудник КАК Сотрудник
    |ПОМЕСТИТЬ ВТ_Начисления
    |ИЗ
    |	РегистрРасчета.ВКМ_ДополнительныеНачисления КАК ВКМ_ДополнительныеНачисления
    |ГДЕ
    |	ВКМ_ДополнительныеНачисления.Сотрудник В(&СписокСотрудников)
    |	И ВКМ_ДополнительныеНачисления.Регистратор = &Регистратор
    |
    |СГРУППИРОВАТЬ ПО
    |	ВКМ_ДополнительныеНачисления.Сотрудник
    |;
    |
    |////////////////////////////////////////////////////////////////////////////////
    |ВЫБРАТЬ
    |	ВТ_Начисления.Сотрудник КАК Сотрудник,
    |	ВТ_Начисления.СуммаНачисления КАК СуммаНачисления,
    |	СУММА(ВКМ_Удержания.Сумма) КАК СуммаУдержания
    |ИЗ
    |	ВТ_Начисления КАК ВТ_Начисления
    |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрРасчета.ВКМ_Удержания КАК ВКМ_Удержания
    |		ПО ВТ_Начисления.Сотрудник = ВКМ_Удержания.Сотрудник
    |ГДЕ
    |	ВКМ_Удержания.Регистратор = &Регистратор
    |	И ВТ_Начисления.Сотрудник В(&СписокСотрудников)
    |
    |СГРУППИРОВАТЬ ПО
    |	ВТ_Начисления.Сотрудник,
    |	ВТ_Начисления.СуммаНачисления";

    Запрос.УстановитьПараметр("СписокСотрудников", Сотрудники);
    Запрос.УстановитьПараметр("Регистратор", Ссылка);

    РезультатЗапроса = Запрос.Выполнить();

    // 3. Обрабатываем результаты запроса и записываем движения взаиморасчетов
    Если Не РезультатЗапроса.Пустой() Тогда
        Выборка = РезультатЗапроса.Выбрать();

        Пока Выборка.Следующий() Цикл
            ДвижениеВзаиморасчеты = Движения.ВКМ_ВзаиморасчетыССотрудниками.Добавить();
            ДвижениеВзаиморасчеты.Период = Дата;
            ДвижениеВзаиморасчеты.ВидДвижения = ВидДвиженияНакопления.Приход;
            ДвижениеВзаиморасчеты.Регистратор = Ссылка; // или используйте документ-основание, если есть
            ДвижениеВзаиморасчеты.Сотрудник = Выборка.Сотрудник;
            ДвижениеВзаиморасчеты.Сумма = Выборка.СуммаНачисления - Выборка.СуммаУдержания;
        КонецЦикла;

        Движения.ВКМ_ВзаиморасчетыССотрудниками.Записать();
	КонецЕсли; 
	
	КонецПроцедуры
